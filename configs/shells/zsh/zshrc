[[ -o interactive ]] || return

bindkey -e
setopt AUTO_LIST
setopt COMPLETE_IN_WORD
setopt CORRECT
setopt EXTENDED_GLOB

# Starship replaces this when available. Keep a usable prompt when the command
# is absent because a Nix or Homebrew profile was not loaded.
PROMPT='%F{cyan}%~%f %# '

# Keep command replacements as aliases. Command shorthands are declared as
# Fish-style abbreviations in $ZDOTDIR/abbreviations.
alias vim='nvim'

if (( $+commands[eza] )); then
	alias ls='eza --group-directories-first'
	alias ll='eza -lah --git --icons --group-directories-first'
	alias la='eza -la --group-directories-first'
fi

setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE

HISTFILE=$ZDOTDIR/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
HISTORY_IGNORE='(ls|ls *)'

# Search both package managers by default. This also supports Nix on macOS and
# Homebrew on Linux; ZSH_PLUGIN_PROVIDER can constrain discovery when desired.
typeset -g ZSH_PLUGIN_PROVIDER="${ZSH_PLUGIN_PROVIDER:-auto}"
typeset -ga _zsh_plugin_share_roots
_zsh_plugin_share_roots=()

if [[ "$ZSH_PLUGIN_PROVIDER" == auto ||
      "$ZSH_PLUGIN_PROVIDER" == homebrew ]]; then
	typeset -g _zsh_brew_prefix=''
	for _zsh_prefix_candidate in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local; do
		if [[ -n "$_zsh_prefix_candidate" &&
		      -d "$_zsh_prefix_candidate/share" ]]; then
			_zsh_brew_prefix="$_zsh_prefix_candidate"
			_zsh_plugin_share_roots+=("$_zsh_brew_prefix/share")
			break
		fi
	done
	unset _zsh_prefix_candidate
fi

if [[ "$ZSH_PLUGIN_PROVIDER" == auto ||
      "$ZSH_PLUGIN_PROVIDER" == nix ]]; then
	for _zsh_share_candidate in \
		"${NIX_PROFILE:+$NIX_PROFILE/share}" \
		"$HOME/.nix-profile/share" \
		"${USER:+/etc/profiles/per-user/$USER/share}" \
		/run/current-system/sw/share \
		/nix/var/nix/profiles/default/share
	do
		if [[ -n "$_zsh_share_candidate" &&
		      -d "$_zsh_share_candidate" ]]; then
			_zsh_plugin_share_roots+=("$_zsh_share_candidate")
		fi
	done
	unset _zsh_share_candidate
fi

typeset -U _zsh_plugin_share_roots

_zsh_find_plugin_file() {
	local _zsh_share_root _zsh_relative_path
	for _zsh_share_root in "$_zsh_plugin_share_roots[@]"; do
		for _zsh_relative_path in "$@"; do
			if [[ -r "$_zsh_share_root/$_zsh_relative_path" ]]; then
				REPLY="$_zsh_share_root/$_zsh_relative_path"
				return 0
			fi
		done
	done
	REPLY=''
	return 1
}

typeset -g _zsh_fzf_tab_file=''
typeset -g _zsh_abbr_file=''
typeset -g _zsh_autosuggestions_file=''
typeset -g _zsh_transient_prompt_file=''
typeset -g _zsh_syntax_highlighting_file=''
typeset -ga _zsh_plugin_completion_dirs
_zsh_plugin_completion_dirs=()

# Nix deployments provide exact store paths here. Other systems fall through
# to profile/Homebrew discovery below.
typeset _zsh_plugin_paths_file="${ZSH_PLUGIN_PATHS_FILE:-$ZDOTDIR/plugin-paths.zsh}"
[[ -r "$_zsh_plugin_paths_file" ]] && source "$_zsh_plugin_paths_file"
unset _zsh_plugin_paths_file

if [[ -z "$_zsh_fzf_tab_file" ]] &&
   _zsh_find_plugin_file fzf-tab/fzf-tab.zsh; then
	_zsh_fzf_tab_file="$REPLY"
fi
if [[ -z "$_zsh_abbr_file" ]] && _zsh_find_plugin_file \
	zsh-abbr/zsh-abbr.zsh \
	zsh/zsh-abbr/zsh-abbr.zsh; then
	_zsh_abbr_file="$REPLY"
fi
if [[ -z "$_zsh_autosuggestions_file" ]] && _zsh_find_plugin_file \
	zsh-autosuggestions/zsh-autosuggestions.zsh \
	zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh; then
	_zsh_autosuggestions_file="$REPLY"
fi
if [[ -z "$_zsh_transient_prompt_file" ]] &&
   _zsh_find_plugin_file zsh-transient-prompt/transient-prompt.zsh-theme; then
	_zsh_transient_prompt_file="$REPLY"
fi
if [[ -z "$_zsh_syntax_highlighting_file" ]] &&
   _zsh_find_plugin_file zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; then
	_zsh_syntax_highlighting_file="$REPLY"
fi

# Completion directories must be added to fpath before compinit. Nix profiles
# merge package completions into zsh/site-functions; Homebrew formulas may use
# either that standard location or a package-specific share directory.
for _zsh_share_root in "$_zsh_plugin_share_roots[@]"; do
	for _zsh_completion_dir in \
		"$_zsh_share_root/zsh/site-functions" \
		"$_zsh_share_root/zsh-completions" \
		"$_zsh_share_root/zsh-abbr" \
		"$_zsh_share_root/zsh/zsh-abbr"
	do
		[[ -d "$_zsh_completion_dir" ]] &&
			fpath=("$_zsh_completion_dir" $fpath)
	done
done
for _zsh_completion_dir in "$_zsh_plugin_completion_dirs[@]"; do
	[[ -d "$_zsh_completion_dir" ]] &&
		fpath=("$_zsh_completion_dir" $fpath)
done
typeset -U fpath
unset _zsh_share_root _zsh_completion_dir

zmodload zsh/complist
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'l' vi-forward-char

autoload -Uz compinit
compinit -d "$ZDOTDIR/.zcompdump"

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompcache"
zstyle ':completion:*:squeeze-slashes' true
zstyle ':completion:*:*:-command-:*:*' group-order alias builtins functions commands
zstyle ':completion:*:file-list' all
zstyle ':completion:*:group-name' ''
zstyle ':completion:*:*:*:*:descriptions' format '%F{green}--> %d%f'
zstyle ':completion:*:warnings' format ' %F{red}!-> no matches found%f'
zstyle ':completion:*:messages' format ' %F{purple}--> %d%f'
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!-> %d (errors: %e)%f'
zstyle ':completion:*' completer _complete _approximate
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# fzf's native integration supplies Ctrl-R history, Ctrl-T files, Alt-C
# directories, and fuzzy completion. All dependencies are optional.
if (( $+commands[fzf] )); then
	export FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border'

	if (( $+commands[fd] )); then
		export FZF_CTRL_T_COMMAND='fd --type f --hidden --follow --exclude .git'
		export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
	fi

	if (( $+commands[bat] )); then
		export FZF_CTRL_T_OPTS="
			--preview 'bat --color=always --style=numbers --line-range=:500 -- {} 2>/dev/null'
			--preview-window 'right:60%:wrap'
		"
	fi

	source <(fzf --zsh 2>/dev/null)
fi

# fzf-tab must load after compinit and fzf, but before autosuggestions.
if (( $+commands[fzf] )) &&
   [[ -n "$_zsh_fzf_tab_file" ]]; then
	source "$_zsh_fzf_tab_file"
	zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --border
	zstyle ':fzf-tab:*' switch-group '<' '>'
fi

# Use command-aware completion when a command is present; otherwise retain
# Ctrl-T's generic file picker.
_fzf_context_widget() {
	if [[ -n "${LBUFFER//[[:space:]]/}" ]] &&
	   (( $+widgets[fzf-tab-complete] )); then
		zle fzf-tab-complete
	elif (( $+widgets[fzf-file-widget] )); then
		zle fzf-file-widget
	else
		zle redisplay
	fi
}

if (( $+widgets[fzf-tab-complete] || $+widgets[fzf-file-widget] )); then
	zle -N _fzf_context_widget
	bindkey '^T' _fzf_context_widget
fi

# Expand shorthands on Space or Enter so history contains the full command.
if [[ -n "$_zsh_abbr_file" ]]; then
	ABBR_USER_ABBREVIATIONS_FILE="$ZDOTDIR/abbreviations"
	source "$_zsh_abbr_file"
fi

# Teach zsh-syntax-highlighting that loaded abbreviations are valid commands.
# The regexp highlighter runs before the main highlighter so its overlapping
# region takes precedence over the unknown-command red.
if (( ${#ABBR_REGULAR_USER_ABBREVIATIONS} )); then
	typeset -ga ZSH_HIGHLIGHT_HIGHLIGHTERS
	(( ${ZSH_HIGHLIGHT_HIGHLIGHTERS[(Ie)main]} )) ||
		ZSH_HIGHLIGHT_HIGHLIGHTERS+=(main)
	(( ${ZSH_HIGHLIGHT_HIGHLIGHTERS[(Ie)regexp]} )) ||
		ZSH_HIGHLIGHT_HIGHLIGHTERS=(regexp $ZSH_HIGHLIGHT_HIGHLIGHTERS)

	typeset -gA ZSH_HIGHLIGHT_REGEXP
	typeset -g _zsh_abbr_highlight_pattern
	_zsh_abbr_highlight_pattern='^[[:blank:][:space:]]*('${(j:|:)${(Qk)ABBR_REGULAR_USER_ABBREVIATIONS}}')$'
	ZSH_HIGHLIGHT_REGEXP+=(
		"$_zsh_abbr_highlight_pattern" 'fg=green'
	)
	unset _zsh_abbr_highlight_pattern
fi

if [[ -n "$_zsh_autosuggestions_file" ]]; then
	ZSH_AUTOSUGGEST_STRATEGY=(history completion)
	ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
	source "$_zsh_autosuggestions_file"
fi

if (( $+commands[zoxide] )); then
	eval "$(zoxide init zsh --cmd z 2>/dev/null)"
fi

if (( $+commands[direnv] )); then
	eval "$(direnv hook zsh 2>/dev/null)"
fi

if (( $+commands[starship] )); then
	if [[ -r "$HOME/.config/starship/default.toml" ]]; then
		export STARSHIP_CONFIG="$HOME/.config/starship/default.toml"
	fi
	eval "$(starship init zsh 2>/dev/null)"
fi

# Collapse completed Starship prompts to the same dim character used by the
# Fish transient prompt. The current prompt remains the full Starship prompt.
if [[ "${STARSHIP_SHELL:-}" == zsh &&
      -n "$_zsh_transient_prompt_file" ]]; then
	TRANSIENT_PROMPT_PROMPT=$PROMPT
	TRANSIENT_PROMPT_RPROMPT=$RPROMPT
	TRANSIENT_PROMPT_TRANSIENT_PROMPT='%F{8}❯%f '
	TRANSIENT_PROMPT_TRANSIENT_RPROMPT=''
	source "$_zsh_transient_prompt_file"
fi

killdns() {
	sudo dscacheutil -flushcache
	sudo killall -HUP mDNSResponder
}

# Syntax highlighting needs to be sourced after every other ZLE integration.
if [[ -n "$_zsh_syntax_highlighting_file" ]]; then
	source "$_zsh_syntax_highlighting_file"
fi

unfunction _zsh_find_plugin_file
unset _zsh_brew_prefix
unset _zsh_plugin_share_roots
unset _zsh_plugin_completion_dirs
unset _zsh_fzf_tab_file
unset _zsh_abbr_file
unset _zsh_autosuggestions_file
unset _zsh_transient_prompt_file
unset _zsh_syntax_highlighting_file
